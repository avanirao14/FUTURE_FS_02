# ==========================================
# Future Interns Full Stack Web Development
# Task 2 (FUTURE_FS_02) - Mini CRM System
# Environment Configuration Template
# ==========================================

# Server Port (Default: 3000)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=development

# JWT Secret for Admin Authentication (change in production)
JWT_SECRET=future-interns-crm-task-2-secret-2026

# MongoDB Connection URI (Optional)
# If provided, connects to MongoDB Atlas or local MongoDB.
# If omitted or unavailable, the system automatically uses a persistent
# disk document database (stored at data/mini_crm_db.json) with zero setup required.
MONGODB_URI=mongodb://localhost:27017/mini_crm_db

# Application Host URL (injected automatically in Cloud Run)
APP_URL=http://localhost:3000
